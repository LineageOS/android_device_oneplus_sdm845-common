cc_binary {
    name: "vendor.lineage.livedisplay-service.oneplus_sdm845",
    init_rc: ["vendor.lineage.livedisplay-service.oneplus_sdm845.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay-service.oneplus_sdm845.xml"],
    relative_install_path: "hw",
    srcs: [
        ":vendor.lineage.livedisplay-sdm-pa",
        ":vendor.lineage.livedisplay-sdm-utils",
        ":vendor.lineage.livedisplay-oneplus-af",
        "DisplayModes.cpp",
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libbinder",
        "libutils",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
    header_libs: [
        "vendor.lineage.livedisplay-sdm-headers",
        "vendor.lineage.livedisplay-oneplus-headers",
    ],
    proprietary: true,
}
